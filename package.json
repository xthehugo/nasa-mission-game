{
  "name": "nasa-mission-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env.local ./node_modules/vite/bin/vite.js",
    "dev": "node --env-file=.env.local ./node_modules/vite/bin/vite.js",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "npx tsx -e \"import { runEngineTestSuite } from './src/engine/engine.test.ts'; const r = runEngineTestSuite(); console.log(`Engine Tests: ${r.passedCount}/${r.total} passed`); if (!r.allPassed) { console.error(r.results.filter(x => !x.passed)); process.exit(1); }\"",
    "preview": "node --env-file=.env.local ./node_modules/vite/bin/vite.js preview",
    "voices:generate": "node --env-file=.env.local scripts/generateVoices.mjs"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.78.0",
    "@tailwindcss/vite": "^4.3.5",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
